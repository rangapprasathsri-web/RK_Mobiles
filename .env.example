# RK MOBILES - Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/rk_mobiles?schema=public"

# Authentication
AUTH_SECRET="generate-a-strong-secret-key-here"
JWT_SECRET="generate-another-strong-secret-key-here"

# Owner Setup (used only for initial seed)
OWNER_EMAIL="owner@rkmobiles.com"
OWNER_PASSWORD="change-this-password"
OWNER_NAME="RK Mobiles Owner"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Image Upload (optional - for Cloudinary)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
